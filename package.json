{
  "name": "agent-grounding",
  "version": "0.1.0",
  "private": true,
  "description": "Verification framework for AI agents — runtime checks, claim validation, hypothesis tracking",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:deps && npm run build --workspaces --if-present",
    "build:deps": "npm run build -w @lannguyensi/grounding-wrapper -w @lannguyensi/evidence-ledger -w @lannguyensi/claim-gate -w @lannguyensi/hypothesis-tracker -w @lannguyensi/runtime-reality-checker",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:pins": "node scripts/check-pins.js",
    "test:check-pins": "node --test scripts/check-pins.test.js",
    "check:deps": "node scripts/check-deps.js",
    "test:check-deps": "node --test scripts/check-deps.test.js",
    "check:lockfile-integrity": "node scripts/check-lockfile-integrity.js",
    "test:check-lockfile-integrity": "node --test scripts/check-lockfile-integrity.test.js",
    "check:okf-kit-pin": "node scripts/check-okf-kit-pin.js",
    "test:check-okf-kit-pin": "node --test scripts/check-okf-kit-pin.test.js",
    "check:okf-test-citation-shape": "node scripts/check-okf-test-citation-shape.js",
    "test:check-okf-test-citation-shape": "node --test scripts/check-okf-test-citation-shape.test.js"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "test-exclude": "^8.0.0"
  },
  "devDependencies": {
    "semver": "^6.3.1"
  }
}
