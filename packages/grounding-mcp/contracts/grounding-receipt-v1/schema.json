{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grounding-receipt:v1",
  "title": "grounding-receipt/v1 envelope and decoded payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "alg",
    "issuer",
    "kid",
    "payload",
    "signature"
  ],
  "properties": {
    "format": {
      "const": "grounding-receipt/v1"
    },
    "alg": {
      "const": "Ed25519"
    },
    "issuer": {
      "$ref": "#/$defs/token"
    },
    "kid": {
      "$ref": "#/$defs/token"
    },
    "payload": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 21846,
      "description": "Unpadded round-trip canonical base64url of at most 16384 bytes; decode and validate against #/$defs/payload."
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "minLength": 86,
      "maxLength": 86
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptId",
        "audience",
        "projectId",
        "taskId",
        "attemptId",
        "nonce",
        "contextRevision",
        "target",
        "subject",
        "policy",
        "session",
        "assessment",
        "evaluatedAt",
        "issuedAt",
        "expiresAt",
        "producer"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "receiptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "audience": {
          "$ref": "#/$defs/token"
        },
        "projectId": {
          "$ref": "#/$defs/uuid"
        },
        "taskId": {
          "$ref": "#/$defs/uuid"
        },
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "minLength": 43,
          "maxLength": 43
        },
        "contextRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workflowId",
            "from",
            "to",
            "action"
          ],
          "properties": {
            "workflowId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "$ref": "#/$defs/token"
            },
            "to": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "$ref": "#/$defs/token"
            }
          }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "task-context/v1"
            },
            "digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "sha256"
          ],
          "properties": {
            "id": {
              "const": "debug-evidence-assessment/v1"
            },
            "revision": {
              "const": "1"
            },
            "sha256": {
              "const": "50c68e4070b5c36c2bd166f61f83377df717253f30933fe05825386d605325a4"
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/token"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "evidenceOrigin",
            "factCount",
            "claimAllowed",
            "reasons",
            "dossierSha256"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "evidenceOrigin": {
              "const": "agent_asserted"
            },
            "factCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "claimAllowed": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "enum": [
                  "session_binding_invalid",
                  "session_revision_invalid",
                  "mandatory_steps_incomplete",
                  "fact_missing",
                  "claim_missing",
                  "claim_prerequisites_missing"
                ]
              },
              "uniqueItems": true,
              "maxItems": 6
            },
            "dossierSha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "pass"
                  }
                }
              },
              "then": {
                "properties": {
                  "factCount": {
                    "minimum": 1
                  },
                  "claimAllowed": {
                    "const": true
                  },
                  "reasons": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "reasons": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "factCount": {
                    "const": 0
                  }
                }
              },
              "then": {
                "properties": {
                  "reasons": {
                    "contains": {
                      "const": "fact_missing"
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "reasons": {
                    "not": {
                      "contains": {
                        "const": "fact_missing"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "claimAllowed": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "reasons": {
                    "contains": {
                      "enum": [
                        "claim_missing",
                        "claim_prerequisites_missing"
                      ]
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "reasons": {
                    "not": {
                      "contains": {
                        "enum": [
                          "claim_missing",
                          "claim_prerequisites_missing"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "evaluatedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "policyBuild"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/token"
            },
            "version": {
              "$ref": "#/$defs/token"
            },
            "policyBuild": {
              "$ref": "#/$defs/token"
            }
          }
        }
      }
    }
  },
  "x-wire": {
    "maxBytes": 32768,
    "encoding": "strict UTF-8 without BOM; reject lone UTF-16 surrogates and duplicate decoded keys",
    "envelopeOrder": [
      "format",
      "alg",
      "issuer",
      "kid",
      "payload",
      "signature"
    ],
    "outerFlexibility": "JSON whitespace and key reordering permitted",
    "payloadCanonical": "UTF-8 JSON with no whitespace, fixed property order as required arrays in $defs/payload and every nested object; exact reserialization equality",
    "maxJsonDepth": 32,
    "signatureInput": "UTF8(\"grounding-receipt/v1\\nEd25519\\n\" + issuer + \"\\n\" + kid + \"\\n\" + payload)"
  },
  "x-invariants": [
    "All base64url values must roundtrip identically with the stated decoded byte counts.",
    "Reasons follow policy.reasonCodes order, without duplicates.",
    "evaluatedAt <= issuedAt < expiresAt and expiresAt - evaluatedAt <= 900.",
    "Standard JSON Schema validation alone does not enforce these byte-order, duplicate-key, base64url roundtrip, or cross-field arithmetic constraints.",
    "verifyReceipt checks only schema and Ed25519 signature under an explicit public key, including fail outcomes. Issuer authorization and expected context are outside this schema."
  ]
}
